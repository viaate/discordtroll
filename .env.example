# Copy this file to ".env" and fill in your real values.
# On Windows:  copy .env.example .env

# Your bot's secret token from https://discord.com/developers/applications
DISCORD_TOKEN=your-bot-token-here

# The Discord user ID of the owner (you). Only this user can issue commands.
# Enable Developer Mode in Discord -> right-click your name -> "Copy User ID".
OWNER_ID=000000000000000000

# Optional: needed only for the AI Impersonator modes (CloneChat, SchizoClone).
# Get one at https://console.anthropic.com/ . Leave blank to disable those modes.
ANTHROPIC_API_KEY=
